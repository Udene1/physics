# Vita configuration
# Never commit real credentials to this file.

GEMINI_API_KEY=
LLM_BACKEND=auto

# PostgreSQL is the authoritative learning-state database.
# Use a TLS connection string in production.
DATABASE_URL=postgresql://vita:change-me@localhost:5432/vita

# Optional local adaptive API port.
VITA_API_PORT=4310

# Required only when exposing teacher intelligence endpoints.
# Generate a long random secret and keep it outside source control.
VITA_TEACHER_API_KEY=
